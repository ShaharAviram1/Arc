# Arc — environment. Copy to `.env` and edit:  cp .env.example .env
#
# `.env` is git-ignored and must never be committed. The values below are
# dev-safe placeholders: they let `make dev` run locally, and every one of
# them must be changed before a production deploy.
#
# The URLs here are host-side: they are what a process running on your
# machine should use. Docker Compose overrides the container-specific ones
# (DATABASE_URL, QBIT_URL) with the compose service hostnames.
#
# Reference: architecture.md §9 (configuration) and §8 (deployment).

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# dev | test | prod. Controls log format (pretty vs JSON) and cookie hardening.
ENV=dev

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Where users reach Arc. Used for links Arc generates (invites, MAL redirect)
# and for the CSRF origin check. In dev this is the Vite dev server; in
# production it is https://<PUBLIC_HOST>, which deploy/docker-compose.yml sets
# for the containers itself — so this value stays host-side. The API logs an
# error at startup if a prod run still sees a localhost PUBLIC_URL.
PUBLIC_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Host-side value: used by `make dev`, `make migrate`, the tests, and any
# process you start yourself from `server/` (uvicorn, `python -m arc.worker`).
# It points at the port the dev compose override publishes on localhost.
# Inside Docker Compose the api and worker services override this with the
# `db` service hostname (deploy/docker-compose.yml), so it needs no change
# for a deploy.
DATABASE_URL=postgresql+asyncpg://arc:arc@localhost:5432/arc

# Consumed by the postgres container (deploy/docker-compose.yml). Keep the
# user/password in step with DATABASE_URL above.
POSTGRES_DB=arc
POSTGRES_USER=arc
POSTGRES_PASSWORD=arc

# ---------------------------------------------------------------------------
# Secrets — regenerate for any real deployment
# ---------------------------------------------------------------------------

# Signs session cookies.   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-not-secret-change-me

# Encrypts stored MAL tokens at rest (architecture.md §7).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---------------------------------------------------------------------------
# Auth (M2) — sessions, login rate limiting, CSRF origins
# ---------------------------------------------------------------------------

# Lifetime of a login session, in days. Expiry *slides*: any request made more
# than a day after the last extension pushes it out again, so this is really
# "days of inactivity before you are logged out". The session cookie is
# HttpOnly + SameSite=Lax, and Secure whenever ENV=prod.
SESSION_TTL_DAYS=30

# Login attempts allowed per client IP, and per email address, inside
# LOGIN_RATE_WINDOW_SECONDS. Every attempt counts, successful or not; the
# 11th (or the 6th for one address) gets 429 with a Retry-After header.
# The counters live in the API process's memory, so each uvicorn worker has
# its own budget and a restart forgets them (see arc/services/auth/ratelimit).
# That is why deploy/docker-compose.yml runs uvicorn with `--workers 1`.
LOGIN_RATE_LIMIT_PER_IP=10
LOGIN_RATE_LIMIT_PER_EMAIL=5
LOGIN_RATE_WINDOW_SECONDS=900

# Requests per client IP, in the same window, to the two *public* invite
# routes (GET /api/invites/{token} and POST /api/invites/{token}/accept).
# Looser than login, because following a link, reloading and submitting is
# several requests from one person; the 21st gets 429.
INVITE_RATE_LIMIT_PER_IP=20

# Extra browser origins allowed to POST/PUT/PATCH/DELETE under /api, as a
# comma-separated list. Leave empty for the normal case: PUBLIC_URL's own
# origin is always allowed, and http://localhost:5173 (Vite) and
# http://localhost:8000 (uvicorn) are added automatically whenever ENV is not
# `prod`. Set it only for a second hostname or a staging domain.
#
# Requests without a matching Origin (or, failing that, Referer) header get
# 403 {"detail":"origin not allowed"}. Browsers send Origin automatically;
# curl and other non-browser clients must add it by hand:
#   curl -H 'Origin: http://localhost:5173' ...
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# MyAnimeList — https://myanimelist.net/apiconfig
# ---------------------------------------------------------------------------

# The client id alone is enough for the read-only catalogue fallback (FR-C6):
# MAL API v2's read endpoints authenticate with an `X-MAL-CLIENT-ID` header and
# nothing else. Set it and Arc keeps searching, opening show pages and adding
# to lists while AniList is unreachable; leave it empty and Arc simply has no
# fallback (`GET /api/catalog/status` then reports mal as unconfigured).
MAL_CLIENT_ID=
# The secret and the redirect are M9's: per-user OAuth for list import and the
# writes of FR-M4. Neither is needed for the catalogue fallback. Leave the
# secret empty if the MAL application was registered as a public client — Arc
# omits the field entirely rather than sending an empty one, which MAL rejects.
MAL_CLIENT_SECRET=
# Must match the redirect URI registered on the MAL app exactly, including the
# path. Arc serves it at `/api/mal/callback`, so in production this is
# `<PUBLIC_URL>/api/mal/callback`.
MAL_REDIRECT_URI=http://localhost:8000/api/mal/callback

# MAL API v2's base URL. Leave as-is; it is configurable so the test suite can
# point it at a mock, the same way ANILIST_URL is.
MAL_API_URL=https://api.myanimelist.net/v2

# Where the OAuth handshake happens. A separate setting because MAL puts
# authorize and token on the main site rather than on the API host. Leave as-is
# outside the test suite.
MAL_OAUTH_URL=https://myanimelist.net/v1/oauth2

# How often every linked account's MyAnimeList list is re-imported, in hours
# (FR-M3 names six as the default). The import also runs the moment an account
# is linked.
MAL_IMPORT_INTERVAL_HOURS=6

# NOTE: linking a MAL account needs FERNET_KEY above. Tokens are stored
# encrypted with it, and the OAuth `state` is a Fernet token rather than a row
# in a table, so an empty FERNET_KEY makes `POST /api/mal/link` answer 503.

# ---------------------------------------------------------------------------
# AniList (M3) — catalogue and airing schedule
# ---------------------------------------------------------------------------

# The GraphQL endpoint. Leave as-is; it is configurable so the test suite can
# point it at a mock and an operator can put a caching proxy in front of it.
ANILIST_URL=https://graphql.anilist.co

# Minimum gap between two AniList requests, in milliseconds. AniList documents
# 90 requests/minute but currently enforces 30; 700 ms keeps Arc under the real
# limit even with both worker slots querying. Raise it if you see 429s.
ANILIST_MIN_INTERVAL_MS=700

# ---------------------------------------------------------------------------
# Catalogue fallback (M3b) — FR-C6
# ---------------------------------------------------------------------------

# How long a catalogue source is skipped after it fails, in seconds. Arc tries
# AniList first and MyAnimeList second; a failure (connection error, timeout,
# 5xx, or AniList's "temporarily disabled" 403) opens a circuit breaker so the
# rest of the outage costs no timeouts at all. The next call after the window
# probes the source again. Lower it if you want a recovery noticed sooner;
# raise it if an outage is costing you a timeout every five minutes.
CATALOG_BREAKER_SECONDS=300

# ---------------------------------------------------------------------------
# Anthropic (M12/M13) — recommendations and match suggestions
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# Show LLM suggestions for files that fall below the match threshold. The
# suggestion is displayed only, never applied automatically.
LLM_MATCH_SUGGESTIONS=false

# ---------------------------------------------------------------------------
# qBittorrent (M6)
# ---------------------------------------------------------------------------

# Host-side value: the dev override publishes the Web UI on localhost, which
# is what `make dev` and anything you run from `server/` talk to. Inside
# Compose the api and worker services override this with
# http://qbittorrent:8080 (deploy/docker-compose.yml).
QBIT_URL=http://localhost:8080

# Web UI credentials. linuxserver/qbittorrent (4.6+) does NOT accept a
# password from the environment: on the very first start it generates a
# temporary one and prints it to the container log. So the first time you
# bring the container up, read it and set a permanent password to match this
# file — the value below is what the api and worker will log in with:
#
#   docker logs arc-qbittorrent-1 | grep -i "temporary password"
#   TMP=<that password>
#   curl -c /tmp/qb -H 'Referer: http://localhost:8080' \
#        -d "username=admin&password=$TMP" \
#        http://localhost:8080/api/v2/auth/login
#   curl -b /tmp/qb -H 'Referer: http://localhost:8080' \
#        --data-urlencode 'json={"web_ui_password":"adminadmin"}' \
#        http://localhost:8080/api/v2/app/setPreferences
#
# It is stored (hashed) in the `qbit_config` volume, so it survives restarts
# and recreations of the container and the log stops printing a temporary one.
# Use a real password anywhere the Web UI is reachable from outside the host.
QBIT_USER=admin
QBIT_PASS=adminadmin

# The category every torrent Arc adds is filed under, and the only one it ever
# polls or deletes. Torrents you add by hand in the same client are invisible
# to Arc as long as they are not in this category.
QBIT_CATEGORY=arc

# Where qBittorrent writes downloads, *as qBittorrent sees it* — a path inside
# its own container, not on your host. Arc maps it onto DATA_DIR/downloads
# below. Leave it alone unless you changed the container's volume layout.
QBIT_DOWNLOADS_PATH=/data/downloads

# ---------------------------------------------------------------------------
# Nyaa (M6)
# ---------------------------------------------------------------------------

# The Nyaa origin. Arc builds the RSS search path itself
# (`/?page=rss&q=…&c=1_2&f=0`) and asks for at most one page every 2 seconds.
NYAA_URL=https://nyaa.si

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------

# Root for downloads/, renditions/, fonts/ and manual/. `/data` inside the
# containers. A *relative* value is resolved against the process's working
# directory, and `make dev` starts the API and the worker from `server/` — so
# `./data` there means `server/data`, not the repository root's. Give it an
# absolute path if you want to be sure which one you are dropping files into;
# the library scan logs the directories it walked, resolved.
DATA_DIR=./data

# Concurrent ffmpeg transcodes in one worker process (architecture.md §8).
# A property of the host's cores, not an editable rule — which is why it lives
# here and not in the `settings` table. A 24-minute 1080p episode is roughly
# real time on two cores at the preset below, so two at once needs four.
MAX_TRANSCODES=2

# ---------------------------------------------------------------------------
# Transcode (M7) — FR-P1..FR-P5, architecture.md §5.3
# ---------------------------------------------------------------------------

# The binaries. A bare name is resolved on PATH; an absolute path is used as
# given, which is how a host with a hardware-enabled or fuller build points Arc
# at it without shadowing the system ffmpeg.
#
# The build MUST have libass: burning subtitles in needs the `ass` filter, and
# without it every transcode fails with "No such filter: 'ass'". Debian's
# `ffmpeg` package (what server/Dockerfile installs) has it. Homebrew's plain
# `ffmpeg` formula does NOT — use `brew install ffmpeg-full`, which is keg-only
# and therefore does not shadow the other one, and point these at
# /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg and .../ffprobe.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# The video encoder. `libx264` is software H.264 and is what the host sizing in
# architecture.md §8 assumes; `h264_vaapi` or `h264_nvenc` is how hardware
# encoding gets enabled later.
FFMPEG_VIDEO_ENCODER=libx264

# x264's speed/size trade-off and its quality target. `veryfast` at CRF 20 is
# about real time on two cores for 1080p and visually transparent for anime.
# Slower presets buy smaller files, not better timing.
FFMPEG_PRESET=veryfast
FFMPEG_CRF=20

# Target HLS segment length, in seconds (FR-P1: "~6 s"). Keyframes are forced
# onto this boundary, so raising it makes seeking coarser and lowering it makes
# the playlist longer and the overhead higher.
HLS_SEGMENT_SECONDS=6

# How long one ffmpeg may run before it is killed and the job retried. Three
# hours: a 24-minute episode is about twenty minutes on the intended hardware,
# and a film at `veryfast` is still well inside it. Keep it comfortably below
# WORKER_STALE_AFTER.
TRANSCODE_TIMEOUT_SECONDS=10800

# ---------------------------------------------------------------------------
# Library: ingest and matching (M5)
# ---------------------------------------------------------------------------

# How often the worker walks DATA_DIR/downloads and DATA_DIR/manual looking
# for new video files (FR-L1). It also scans once at start-up, so a file
# dropped in while the worker was down is picked up immediately.
LIBRARY_SCAN_INTERVAL_SECONDS=120

# A file modified more recently than this is skipped and picked up on the next
# scan: a copy that is still being written has a size, and a duration, that
# are both wrong. Raise it if you copy large files in over a slow network.
LIBRARY_SETTLE_SECONDS=60

# Extensions the scan treats as video. Comma separated, no dots.
VIDEO_EXTENSIONS=mkv,mp4,avi,ts,webm

# Match confidence at or above which a file is linked to an episode without
# asking anybody (FR-L4). Nothing below this is ever auto-linked — that is a
# product rule, not a tuning knob; lowering it makes Arc guess.
MATCH_AUTO_THRESHOLD=0.85

# Below this a candidate is not worth showing a person either, and the file
# becomes a "no good candidates" item in the review queue.
MATCH_MIN_CANDIDATE=0.40

# The title similarity an automatic link needs on top of the confidence.
# Confidence is a weighted sum, so a title that is merely close can be carried
# over MATCH_AUTO_THRESHOLD by a season, a format and an episode number that
# all agree — which is how "Kaijuu 9-gou - 05" would be linked to Kaijuu
# 8-gou. At the default the rule is "the filename must literally name the
# show, or the file goes to review"; lower it to let close spellings link
# themselves.
MATCH_MIN_TITLE_FOR_AUTO=0.92

# How many *new* files one scan pass indexes before leaving the rest for the
# next pass. A first scan of an existing library is thousands of files and one
# ffprobe each; without a cap that job runs longer than WORKER_STALE_AFTER and
# is requeued underneath itself.
LIBRARY_SCAN_BATCH=200

# How many files are indexed between commits inside one pass.
LIBRARY_SCAN_COMMIT_EVERY=25

# ---------------------------------------------------------------------------
# Retention (M10) — FR-T1..FR-T5, architecture.md §5.7
# ---------------------------------------------------------------------------

# The two retention windows are NOT here. G (grace_days_g, default 7 — days
# between the last person finishing an episode and its files being deleted)
# and D (unwatched_days_d, default 21 — days a ready episode may sit unwatched
# before that want is dropped) are admin-editable rules and live in the
# `settings` table with look_ahead_n, seeded by the first migration (FR-T5).
# Change them there, not here.

# What lives here is the brake. When true, the hourly sweep works out exactly
# what it would delete, logs it (and serves it from GET /api/retention/preview)
# and then deletes nothing at all — no file, no row, no state change. Turn it
# on for the first night on a new deployment, read the log, turn it off.
RETENTION_DRY_RUN=false

# ---------------------------------------------------------------------------
# Worker (M1) — the job runner in `python -m arc.worker`
# ---------------------------------------------------------------------------

# How many jobs the worker runs at once. Raise it for a busier queue; ffmpeg
# has its own, smaller cap in MAX_TRANSCODES.
WORKER_CONCURRENCY=2

# Seconds to wait before polling the jobs table again when it was empty.
WORKER_POLL_INTERVAL=1.0

# On SIGINT/SIGTERM, seconds to let in-flight jobs finish before cancelling
# them. Anything cancelled is reset to pending on the way out, and anything
# missed by that is picked up again by the stale-job sweep.
WORKER_DRAIN_TIMEOUT=30

# Seconds a job may stay `running` before the sweep decides the worker holding
# it has died and returns the row to the queue. This MUST exceed the longest
# a real job is expected to take: set it too low and a slow job is requeued
# while it is still running (handlers are idempotent, so the cost is duplicated
# work rather than corruption). Two hours, because a transcode (M7) is the
# longest job Arc has — against a three-hour TRANSCODE_TIMEOUT_SECONDS and a
# transcode that pushes its own `locked_at` forward every minute while ffmpeg
# is running, so the sweep only ever sees one that has genuinely stopped.
WORKER_STALE_AFTER=7200

# ---------------------------------------------------------------------------
# First-boot admin (M2). Registration is invite-only, so the first admin has
# to come from somewhere: if both are set and no account has that address,
# the API creates it as an admin on startup and logs the fact.
#
# Idempotent and non-destructive — it never touches an existing account's
# password, role or active flag — so leaving these in place is harmless. The
# password must satisfy the policy (10-128 characters) or the account is not
# created and the reason is logged.
#
# BOOTSTRAP_ADMIN_PASSWORD ships EMPTY on purpose: an example file with a
# password in it is a password that ends up in production. Set a real one of
# at least 10 characters for the first boot; empty means no bootstrap runs at
# all, and the API says so in its startup log. Once the account exists you can
# blank it again.
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
# ---------------------------------------------------------------------------

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Deployment (deploy/docker-compose.yml, deploy/Caddyfile)
# ---------------------------------------------------------------------------

# Hostname Caddy serves and requests a certificate for. `localhost` gives a
# self-signed internal certificate, which is fine for a local trial run.
PUBLIC_HOST=localhost

# Ownership of the qBittorrent config and the shared data volume. Match the
# host user that owns them:  id -u  /  id -g
PUID=1000
PGID=1000
TZ=UTC
